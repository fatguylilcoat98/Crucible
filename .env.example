# Copy to .env and fill in. Both values are required for a server deployment.

# Your Claude API key — the council runs on it.
ANTHROPIC_API_KEY=sk-ant-...

# The gate for the whole API. Anyone without this key gets 401; without it
# set, anyone who finds the URL spends your Anthropic credits and can read
# your ledger. Generate one:  openssl rand -hex 24
CRUCIBLE_ACCESS_KEY=

# Optional overrides:
# CRUCIBLE_MODEL=claude-sonnet-5
# CRUCIBLE_MAX_TOKENS=2000
